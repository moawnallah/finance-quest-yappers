          ],
          "answer": 2,
          "why": "March 2013 after the 2008 crash, and August 2020 after the 2020 crash.",
          "sources": [
            "https://finance.yahoo.com/quote/%5EGSPC/history/"
          ]
        },
        {
          "id": "stocks.s4.q3",
          "q": "Markets fall 30% in a month. What do you do: sell, hold or buy more?",
          "options": [
            "Sell everything now",
            "Hold and keep my plan",
            "Buy a bit more"
          ],
          "feedback": [
            "Selling locks in the loss. In 2008 and 2020 the S&P 500 later recovered its old high (Mar 2013, Aug 2020).",
            "Holding is what recovered in past crashes, if you don't need the money soon.",
            "Buying at lower prices can help long-term, but only with spare money and a long horizon."
          ],
          "sources": [
            "https://finance.yahoo.com/quote/%5EGSPC/history/"
          ]
        }
      ]
