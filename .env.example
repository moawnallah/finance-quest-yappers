# Config names only. Real values go in Secret Manager, never in git.
DATABASE_URL=
GCP_PROJECT_ID=
VERTEX_AI_REGION=europe-central2
# Tutor (backend/ml, docs/tutor_agent.md)
OLLAMA_API_BASE=
TUTOR_MODEL=
ROUTER_MODEL=
CLOUD_MODEL=
LLM_CONFIG=
PROMPT_VERSION=tutor-v2
TUTOR_ENABLED=true
CLOUD_ROLES_ENABLED=false
MODEL_ALLOWLIST=
DAILY_BUDGET=80
TUTOR_PER_MINUTE=8
# Backend access (backend/app/config.py)
ADMIN_KEY=
ADMIN_EMAILS=
# Study mode: facilitators send it as X-Study-Key to start a participant session
STUDY_KEY=
# Tutor pipeline with server-side context and output checks (docs/tutor_agent.md); default false
TUTOR_PIPELINE=
TUTOR_TIMEOUT=90
TUTOR_PER_MINUTE=8
# JSON headers for a proxy in front of Ollama, e.g. {"Authorization": "Bearer ..."}
OLLAMA_HEADERS=
# Path decision (backend/app/path_decider.py): shadow (default) or primary; primary needs BASAL_URL
BASAL_MODE=shadow
BASAL_URL=
BASAL_AUTH_HEADER=
# Serve tasks no reviewer has signed off yet; default 1 (on for the demo), set 0 in production
SERVE_DRAFTS=1
